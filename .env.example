# HousePlug environment variables.
# Copy this file to `.env.local` and fill in real values. Never commit secrets.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
# Public base URL, used in emails and OAuth redirects (e.g. https://houseplug.ng).
NEXT_PUBLIC_APP_URL=

# --- Payments (Paystack) ----------------------------------------------------
# Secret key — server-only. Used for transaction init, verify, and webhook signature.
PAYSTACK_SECRET_KEY=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Verified sender address (e.g. "HousePlug <noreply@houseplug.ng>").
EMAIL_FROM=

# --- AI descriptions (Groq) -------------------------------------------------
GROQ_API_KEY=

# --- Cloudinary (listing tour videos) ---------------------------------------
# Public values used for unsigned browser uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Signed, server-only credentials. Required to DELETE videos when a listing is
# removed (see lib/storage.ts). Without them, uploads still work but orphaned
# videos are left in Cloudinary on delete. Get these from the Cloudinary dashboard.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
